# Backend REST API base URL (Spring Boot on Render).
VITE_API_URL=https://homiewood-p3p5.onrender.com/api

# WebSocket (SockJS/STOMP) endpoint for live ratings. Must be the same host
# as VITE_API_URL: the STOMP broker is in-memory per backend instance.
VITE_WS_URL=https://homiewood-p3p5.onrender.com/ws
